# Copy to .env and edit. Never commit the real .env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/codeguard
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=262144
CORS_ORIGIN=http://localhost:5173
# If set, people registering as PROFESSOR must supply this code. Leave empty for open registration (demo only).
PROFESSOR_INVITE_CODE=
# Detector defaults (can be overridden per analysis request)
DEFAULT_THRESHOLD=0.6
KGRAM_SIZE=5
WINNOW_WINDOW=4
MIN_FINGERPRINTS=5
